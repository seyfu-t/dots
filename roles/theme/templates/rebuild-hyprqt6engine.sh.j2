#!/usr/bin/env bash
set -euo pipefail

state_dir="{{ theme_hyprqt6engine_state_dir }}"
marker="${state_dir}/rebuild-needed"
lock_file="${state_dir}/rebuild.lock"
build_user="{{ play_user }}"
build_dir="{{ theme_hyprqt6engine_build_dir }}"
package_name="{{ theme_hyprqt6engine_package }}"
pacman_lock=/var/lib/pacman/db.lck

[[ -e "${marker}" ]] || exit 0

exec 9>"${lock_file}"
flock -n 9 || exit 0

attempt=0
while [[ -e "${pacman_lock}" && ${attempt} -lt 60 ]]; do
    sleep 1
    ((attempt += 1))
done

if [[ -e "${pacman_lock}" ]]; then
    echo "Timed out waiting for pacman's database lock" >&2
    exit 1
fi

build_home="$(getent passwd "${build_user}" | cut -d: -f6)"
if [[ -z "${build_home}" ]]; then
    echo "Unable to find home directory for ${build_user}" >&2
    exit 1
fi

run_as_build_user() {
    runuser -u "${build_user}" -- env HOME="${build_home}" XDG_CACHE_HOME="{{ play_user_cache_dir }}" "$@"
}

run_as_build_user mkdir -p "$(dirname "${build_dir}")"

if [[ -d "${build_dir}/.git" ]]; then
    run_as_build_user git -C "${build_dir}" pull --ff-only
else
    run_as_build_user rm -rf "${build_dir}"
    run_as_build_user git clone "https://aur.archlinux.org/${package_name}.git" "${build_dir}"
fi

run_as_build_user bash -c '
    cd "$1"
    rm -f -- ./*.pkg.tar.zst
    makepkg --cleanbuild --force --noconfirm
' bash "${build_dir}"

package_file="$(find "${build_dir}" -maxdepth 1 -type f -name "${package_name}-[0-9]*.pkg.tar.zst" -print -quit)"
if [[ -z "${package_file}" ]]; then
    echo "No built ${package_name} package found" >&2
    exit 1
fi

pacman -U --noconfirm "${package_file}"
rm -f "${marker}"
